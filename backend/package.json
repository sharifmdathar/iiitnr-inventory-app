{
  "name": "@iiitnr/backend",
  "version": "1.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run migrate && bun --watch src/server.ts",
    "build": "tsc",
    "start": "bun run migrate && bun run src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "migrate": "bun run src/index.ts",
    "seed": "bun run scripts/seed.ts",
    "create:user": "bun run scripts/create-user.ts",
    "migrate:backup": "bun run scripts/migrate-with-backup.ts",
    "test": "bun test --parallel=1"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "ajv": "^8.20.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.1",
    "fastify-sse-v2": "^4.2.2",
    "google-auth-library": "^11.0.2",
    "it-pushable": "^3.2.4",
    "pg": "8.23.0",
    "sharp": "^0.35.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/pg": "8.18.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "@types/pg": "8.18.0"
  }
}
