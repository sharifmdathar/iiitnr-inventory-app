inventory.iiitnr.ac.in {
    tls /etc/caddy/certs/acnew.pem /etc/caddy/certs/ac.key

    reverse_proxy backend:4000

    encode zstd gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
